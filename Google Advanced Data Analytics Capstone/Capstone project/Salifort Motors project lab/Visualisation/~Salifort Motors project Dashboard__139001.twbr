          <alias key='&quot;[federated.1bb8dsn03x3nqs161sasy1y1gamu].[usr:Calculation_336925615369256963:qk]&quot;' value='Model Accuracy' />
        </aliases>
      </column>
      <column caption='Turnover Rate' datatype='real' name='[Calculation_336925615368400896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([left]) / COUNT([left])' />
      </column>
      <column caption='Average Satisfaction' datatype='real' name='[Calculation_336925615368949761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([satisfaction_level])' />
      </column>
      <column caption='Average Monthly Hours calculated' datatype='real' name='[Calculation_336925615369068546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([model_accuracy])' />
      </column>
      <column caption='Model Accuracy calculated' datatype='real' name='[Calculation_336925615369256963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([model_accuracy])' />
      </column>
      <column caption='Satisfaction Category' datatype='string' name='[Calculation_336925615392382980]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [satisfaction_level] &lt; 0.4 THEN &quot;Low&quot;&#13;&#10;ELSEIF [satisfaction_level] &lt; 0.7 THEN &quot;Meidum&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Turnover Risk Zone' datatype='string' name='[Calculation_978125612480557056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 2 THEN &quot;New Joiners&quot;&#13;&#10;ELSEIF [tenure] &lt;= 5 THEN &quot;Critical Retention Period&quot;&#13;&#10;ELSE &quot;Stable Employees (6+)&quot;&#13;&#10;END' />
      </column>
      <column caption='Risk Level' datatype='string' name='[Calculation_978125612534038529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [predicted_probability] &gt;= 0.7 THEN &quot;High Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='Risk Rank' datatype='integer' name='[Calculation_978125612547637251]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
